# dependencies
node_modules/

# build output
dist/
src-tauri/target/
src-tauri/gen/

# test artefacts
coverage/
test-results/
playwright-report/
blob-report/
tests/e2e/**/*-actual.png
tests/e2e/**/*-diff.png

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# local env
.env
.env.local
*.log

# Update signing keys. The public half lives in tauri.conf.json; the private half must never
# be committed — anyone holding it can sign an update for every installed copy. There is a test
# in ipc/update.rs that fails the build if one appears in the tree anyway.
*.key
*.key.pub

# Generated by build.rs from capabilities-optional/ when the matching Cargo feature is on.
# The reviewable copy is the one in capabilities-optional/, which IS in version control.
src-tauri/capabilities/updater.json
