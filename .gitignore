# dependencies
node_modules/

# build output
dist/
src-tauri/target/
src-tauri/gen/

# test artefacts
coverage/
test-results/
playwright-report/
blob-report/
tests/e2e/**/*-actual.png
tests/e2e/**/*-diff.png

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# local env
.env
.env.local
*.log

# Update signing keys. The public half lives in tauri.conf.json; the private half must never
# be committed — anyone holding it can sign an update for every installed copy. There is a test
# in ipc/update.rs that fails the build if one appears in the tree anyway.
*.key
*.key.pub

# The sign-in applications a build carries. Read by build.rs; see src-tauri/oauth/README.md.
# The Google client secret is in here, and the repository is public (docs/05 §9). The
# committed template is clients.env.example, which this pattern does not match. A test in
# accounts/mod.rs fails if this line is removed or the real file is ever tracked.
src-tauri/oauth/clients.env

# What test/dovecot/certs.sh writes when it is run from a checkout. The rig's certificates live
# on the Docker host; a copy here would be a trusted CA's certificate and a server's private key
# waiting to be committed (`*.key` above catches only the key).
test/dovecot/certs/
test/dovecot/certs.next/

# Generated by build.rs from capabilities-optional/ when the matching Cargo feature is on.
# The reviewable copy is the one in capabilities-optional/, which IS in version control.
src-tauri/capabilities/updater.json

# Reference screenshots pasted in for a conversation. Kept out of git deliberately: the ones
# here are captures of a real mailbox and carry real addresses and real subject lines. If a
# reference capture is ever wanted in the repo, it belongs in assets/reference/ and should be
# of an account nobody minds publishing.
Sample images/

# The designer's raw export of the 2026-09-17 icon set, as it was handed over: the PNGs and SVGs
# plus the design tool's own HTML, scripts and _ds/ bundle. What the app uses was copied into
# assets/brand/, which is the tracked source; this folder is the delivery, not the source.
# Prettier reads this file too, so this also keeps `format:check` off the tool's files.
Halcyon Mail App Logo/
