# Built-in sign-in applications. See README.md in this directory.
#
# Copy this file to clients.env (which git ignores) and fill it in. Never put real values in
# this file: it is committed, and the repository is public.
#
# Google needs BOTH lines or neither — the build refuses to compile in half a pair.

HALCYON_GOOGLE_CLIENT_ID=
HALCYON_GOOGLE_CLIENT_SECRET=

# Microsoft public clients have no secret.
HALCYON_MICROSOFT_CLIENT_ID=
