# Normalise to LF in the repository. Without this, working on Windows rewrites every file
# to CRLF on checkout and every diff is noise.
* text=auto eol=lf

# Never touched by line-ending conversion.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.woff binary
*.woff2 binary
*.eml binary

# Generated; collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true -diff
src-tauri/Cargo.lock linguist-generated=true -diff
